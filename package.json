{
  "name": "app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --clear --reset-cache",
    "doctor": "expo-doctor",
    "build:conf": "eas build:configure -p android",
    "build:dev": "eas build --profile development --platform android",
    "build:prod": "eas build --profile production",
    "build:update": "eas update --channel development --message Testing...",
    "prebuild": "expo prebuild -p android --bun --clean",
    "lint": "biome lint --write ./src",
    "format": "biome format --write ./src"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.2",
    "@hookform/resolvers": "^3.10.0",
    "@react-navigation/native": "^7.0.14",
    "clsx": "^2.1.1",
    "expo": "~52.0.25",
    "expo-font": "~13.0.3",
    "expo-linking": "~7.0.4",
    "expo-router": "~4.0.16",
    "expo-splash-screen": "~0.29.20",
    "expo-sqlite": "~15.0.6",
    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "~4.0.7",
    "expo-web-browser": "~14.0.2",
    "nativewind": "^4.1.23",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.54.2",
    "react-native": "0.76.6",
    "react-native-paper": "^5.13.1",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "@biomejs/biome": "1.9.4",
    "typescript": "~5.3.3"
  },
  "private": true
}
